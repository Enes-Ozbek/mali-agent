.venv/
__pycache__/
*.pyc
.pytest_cache/

# Never commit real invoices or the database built from them.
sample_invoices/
sample_archive/
*.db
*.sqlite3

# Embedding cache -- regenerable from categories.jsonl, and large.
# The trained head (malimusavir/models/*.npz) IS committed: it is small and means
# nobody has to retrain to use the project.
training/data/embeddings.npz

# PyInstaller build output -- regenerable, and 215 MB.
build/
dist/

# Office lock files -- created beside any .doc/.xls left open in Word or Excel.
~$*

# Personal documents. Nothing stopped a staj raporu being committed to this repo
# once, and deleting it later did not remove it from history -- it took a rewrite.
# Add an exception deliberately if a Word document ever belongs here.
*.docx
*.doc
*.xlsx
*.xls

# Screenshots from browser test runs.
live_shot.png
preview_shot.png

# Coverage artifact -- regenerated by every pytest --cov run.
.coverage
htmlcov/
